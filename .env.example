# ============================================================
# Blush Beauty — environment variables (TEMPLATE)
#
# Copy to `.env` and fill in your own values. NEVER commit a real
# `.env` or real credentials. This file lists NAMES ONLY.
#
# The static site itself needs NO server env vars: the two PUBLIC
# values (SUPABASE_URL, SUPABASE_ANON_KEY) belong in config.js and
# are safe to expose — Row Level Security protects the data. The
# secret service-role key must NEVER be placed in config.js or any
# frontend file.
# ============================================================

# ---- Supabase (used by the Edge Functions runtime) ----
# When deployed with `npx supabase functions deploy`, the runtime
# injects these automatically. They are listed here for local
# serving (`supabase functions serve`) and documentation.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key-here
# SERVICE-ROLE KEY: server-side ONLY (storage-cleanup, wheel-spin,
# create-order). Never expose it through the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-ship-to-browser

# ---- Wheel of Fortune (Run 12) ----
# HMAC secret for the signed anonymous participation tokens issued by
# the wheel-spin Edge Function. OPTIONAL: when unset, the function
# derives a runtime-internal key from the service-role credential —
# the secret never leaves server memory either way. Set a dedicated
# random value (e.g. `openssl rand -hex 32`) in production.
WHEEL_TOKEN_SECRET=generate-a-long-random-secret-here

# ---- Where to put the PUBLIC values instead ----
# config.js  →  SUPABASE_URL, SUPABASE_ANON_KEY (public / safe)
#               ORDER_FUNCTION, BUCKET_PRODUCTS, BUCKET_BRAND
